<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WhatsApp - Edit Chat</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <!-- Top Navigation Bar -->
    <header class="wa-navbar">
        <a href="/" class="wa-brand">
            <div class="wa-logo-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C6.48 2 2 6.48 2 12c0 1.85.5 3.58 1.38 5.08L2 22l5.08-1.34C8.54 21.49 10.22 22 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2zm1 14h-2v-2h2v2zm0-4h-2V7h2v5z"/>
                </svg>
            </div>
            <div class="wa-brand-text">
                <h1>WhatsApp</h1>
                <span><span class="wa-status-dot"></span> Edit Message</span>
            </div>
        </a>
        <div class="wa-nav-actions">
            <a href="/chats" class="btn btn-light">All Chats</a>
        </div>
    </header>

    <!-- Main Container -->
    <main class="app-container">
        <div class="form-card">
            <!-- Form Card Header -->
            <div class="form-header">
                <h2>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                    </svg>
                    Edit Chat Message
                </h2>
                <a href="/chats" class="btn btn-light" style="padding: 4px 10px; font-size: 0.78rem;">← Back</a>
            </div>

            <!-- Form Body -->
            <div class="form-body">
                <!-- Info banner displaying existing participants -->
                <div class="info-banner">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <line x1="12" y1="16" x2="12" y2="12"></line>
                        <line x1="12" y1="8" x2="12.01" y2="8"></line>
                    </svg>
                    <div>
                        Conversation between <b><%= nchat.from %></b> and <b><%= nchat.to %></b>
                        <div style="font-size: 0.75rem; color: var(--wa-text-muted); margin-top: 2px;">
                            Chat ID: <code><%= nchat._id %></code>
                        </div>
                    </div>
                </div>

                <!-- We can't directly send PUT / DELETE from HTML forms, so we use the method-override middleware -->
                <form 
                    action="/chats/<%= nchat._id %>?_method=PUT" 
                    method="POST" 
                    onsubmit="return confirm('Are you sure you want to update this chat message?')"
                >
                    <!-- Message Textarea -->
                    <div class="form-group">
                        <label for="message">Update Message <span class="required">*</span></label>
                        <textarea 
                            id="message"
                            class="form-control" 
                            name="message" 
                            rows="5" 
                            maxlength="50" 
                            placeholder="Enter updated message (max 50 characters)..." 
                            required
                            oninput="document.getElementById('char-count').innerText = this.value.length"
                        ><%= nchat.message %></textarea>
                        <div class="form-helper">
                            <span>Maximum 50 characters allowed</span>
                            <span><span id="char-count"><%= nchat.message ? nchat.message.length : 0 %></span> / 50 characters</span>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="form-actions">
                        <a href="/chats" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            Update Message
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </main>
</body>
</html>
