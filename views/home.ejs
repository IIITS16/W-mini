<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WhatsApp Web - Welcome</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <!-- Top Navigation Bar -->
    <header class="wa-navbar">
        <a href="/" class="wa-brand">
            <div class="wa-logo-icon">
                <!-- Chat Bubble SVG Icon -->
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C6.48 2 2 6.48 2 12c0 1.85.5 3.58 1.38 5.08L2 22l5.08-1.34C8.54 21.49 10.22 22 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2zm1 14h-2v-2h2v2zm0-4h-2V7h2v5z"/>
                </svg>
            </div>
            <div class="wa-brand-text">
                <h1>WhatsApp</h1>
                <span><span class="wa-status-dot"></span> Online</span>
            </div>
        </a>
        <div class="wa-nav-actions">
            <a href="/chats" class="btn btn-light">View Chats</a>
        </div>
    </header>

    <!-- Main Container -->
    <main class="app-container">
        <section class="hero-card">
            <div class="hero-icon">
                <svg width="44" height="44" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z"/>
                </svg>
            </div>
            <h2 class="hero-title">Welcome to WhatsApp</h2>
            <p class="hero-subtitle">
                A simple, modern, full-stack messaging application built with Node.js, Express, MongoDB, and EJS.
            </p>

            <div class="hero-actions">
                <a href="/chats" class="btn btn-primary">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                    All Chats
                </a>
                <a href="/chats/new" class="btn btn-secondary">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    New Chat
                </a>
            </div>

            <!-- Highlights Grid -->
            <div class="features-grid">
                <div class="feature-pill">
                    <div class="feature-pill-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </div>
                    <div>
                        <h4>Full CRUD Support</h4>
                        <p>Create, read, update, and delete chats easily.</p>
                    </div>
                </div>
                <div class="feature-pill">
                    <div class="feature-pill-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                        </svg>
                    </div>
                    <div>
                        <h4>MongoDB & Mongoose</h4>
                        <p>Reliable persistent document storage.</p>
                    </div>
                </div>
                <div class="feature-pill">
                    <div class="feature-pill-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                            <line x1="12" y1="18" x2="12.01" y2="18"></line>
                        </svg>
                    </div>
                    <div>
                        <h4>Responsive Layout</h4>
                        <p>Optimized for mobile phones and desktop displays.</p>
                    </div>
                </div>
            </div>
        </section>
    </main>
</body>
</html>
